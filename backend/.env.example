# VigilantEye backend — optional local (non-Docker API) mode
# Canonical setting is DATABASE_URL. Legacy DATABASE_* vars are fallback only.

APP_ENV=development
AUTH_MODE=google
PASSWORD_LOGIN_ENABLED=0
ENABLE_DEMO_SEED=0
GOOGLE_CLIENT_ID=111228928381-acg2mgm9hu30htt3hd7umb4b4hs87rtn.apps.googleusercontent.com
# ENABLE_API_DOCS=1

# Point at Compose Postgres on the host-mapped port (recommended local hybrid):
DATABASE_URL=postgresql+psycopg://vigilant:CHANGE_ME_LOCAL_ONLY@127.0.0.1:15432/vigilant_eye

JWT_SECRET=CHANGE_ME_LOCAL_ONLY_USE_LONG_RANDOM
# Prefer 60 for production; demo may override higher.
JWT_EXPIRE_MINUTES=60

# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Legacy fallback (used only if DATABASE_URL is unset):
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=15432
# DATABASE_NAME=vigilant_eye
# DATABASE_USER=vigilant
# DATABASE_PASSWORD=CHANGE_ME_LOCAL_ONLY

# Optional SMTP. Add the Gmail App Password privately to root .env before use.
EMAIL_ENABLED=1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=vigilanteyenotifications@gmail.com
# SMTP_USERNAME=
# Set SMTP_PASSWORD privately in the ignored root .env; never commit it.
SMTP_PASSWORD=
SMTP_FROM=vigilanteyenotifications@gmail.com
# SMTP_FROM_EMAIL=
SMTP_FROM_NAME=VigilantEye
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
PORTAL_BASE_URL=http://localhost:5173
