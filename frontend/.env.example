# Browser → API base URL (no trailing slash)
VITE_API_URL=http://127.0.0.1:8000

# Public Google OAuth client ID (same value as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# Demo/viva login shortcuts + demo monitoring link.
# Unset / 0 for production builds. Vite DEV (`npm run dev`) enables helpers
# automatically even when this is unset.
# VITE_ENABLE_DEMO_HELPERS=1
